# Garmin 同步配置 —— 复制成 garmin/.env 再填（garmin/.env 已被 gitignore，绝不提交）

# Garmin Connect 账号（仅首次 garmin_login.py 换 token 时需要；换到 token 后可留空）
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# 佳明中国（Garmin 中国 App / connect.garmin.cn 注册的账号）设 true；国际版留 false
GARMIN_IS_CN=false

# garth token 存放目录（换到的登录凭证，有效约 1 年）
GARMIN_TOKENSTORE=/opt/selftend/garmin/tokens

# SelfTend 导入接口（服务器本机直连后端，无需经 nginx）
SELFTEND_IMPORT_URL=http://localhost:8080/api/sleep-logs/import

# 与后端 backend/.env 里的 SLEEP_IMPORT_SECRET 保持完全一致
SLEEP_IMPORT_SECRET=change-me-same-as-backend
